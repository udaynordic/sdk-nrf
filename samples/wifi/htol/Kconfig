source "Kconfig.zephyr"

menu "nRF71 HTOL test sample"

config HTOL_HEARTBEAT_INTERVAL_S
	int "Heartbeat log interval (seconds)"
	default 10
	help
	  Interval for the idle heartbeat message while the sample waits for
	  host-to-LMAC patch test code to be added.

endmenu